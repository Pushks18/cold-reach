# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=3333

# Chrome profile path (required for LinkedIn automation)
# macOS: /Users/you/Library/Application Support/Google/Chrome/Default
# Linux: /home/you/.config/google-chrome/Default
CHROME_PROFILE_PATH=

# Scheduler (minutes between scraping runs)
SCHEDULER_INTERVAL_MINUTES=120

# Auto-apply: set to "true" to enable real job submissions (default: dry run)
AUTO_APPLY_LIVE=false

# Local LLM for answering application questions
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Email enrichment APIs (all optional — each is tried in order)
HUNTER_API_KEY=
APOLLO_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
PDLABS_API_KEY=
OPENAI_API_KEY=
